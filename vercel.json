{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "env -u npm_config_cache_dir -u pnpm_config_cache_dir npm install",
  "buildCommand": "env -u npm_config_cache_dir -u pnpm_config_cache_dir npm run build",
  "crons": [
    {
      "path": "/api/cron/subscriptions",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/cron/whatsapp",
      "schedule": "30 0 * * *"
    }
  ]
}
