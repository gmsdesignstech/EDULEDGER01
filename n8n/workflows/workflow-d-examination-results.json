{
  "name": "Workflow D – EduLedger Examination Results",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "exam-results-webhook",
        "options": {}
      },
      "id": "node-webhook-exam",
      "name": "Webhook – Exam Results Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        180,
        300
      ],
      "webhookId": "eduledger-exam-results-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.parent.hasConsent }}",
              "value2": true
            },
            {
              "value1": "={{ $json.parent.optedOut }}",
              "value2": false
            }
          ],
          "string": [
            {
              "value1": "={{ $json.eventType }}",
              "value2": "examination.published"
            }
          ]
        }
      },
      "id": "node-validate-exam",
      "name": "Verify Exam Published & Consent",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID || '{{WHATSAPP_PHONE_NUMBER_ID}}' }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHATSAPP_ACCESS_TOKEN || '{{WHATSAPP_ACCESS_TOKEN}}' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"recipient_type\": \"individual\",\n  \"to\": \"{{ $json.parent.phone.replace(/\\D/g, '') }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": {{ JSON.stringify($json.template.renderedMessage) }}\n  }\n}",
        "options": {
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 2000
        }
      },
      "id": "node-send-exam-whatsapp",
      "name": "Send WhatsApp Exam Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        680,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EDULEDGER_WEBHOOK_URL || '{{EDULEDGER_WEBHOOK_URL}}' }}/api/whatsapp/webhook",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"providerMessageId\": \"{{ $json.messages ? $json.messages[0].id : '' }}\",\n  \"status\": \"sent\",\n  \"timestamp\": \"{{ new Date().toISOString() }}\",\n  \"eventType\": \"examination.published\"\n}",
        "options": {
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 2000
        }
      },
      "id": "node-exam-callback",
      "name": "Update History Callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        920,
        240
      ]
    }
  ],
  "connections": {
    "Webhook – Exam Results Event": {
      "main": [
        [
          {
            "node": "Verify Exam Published & Consent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Exam Published & Consent": {
      "main": [
        [
          {
            "node": "Send WhatsApp Exam Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp Exam Result": {
      "main": [
        [
          {
            "node": "Update History Callback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}