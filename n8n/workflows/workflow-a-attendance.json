{
  "name": "Workflow A – EduLedger Attendance Notification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "attendance-notification",
        "options": {}
      },
      "id": "node-webhook-attendance",
      "name": "Webhook – Attendance Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        180,
        300
      ],
      "webhookId": "eduledger-attendance-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Verify Webhook Signature from EduLedger\nconst crypto = require('crypto');\nconst headerSig = $input.first().headers['x-eduledger-signature'] || '';\nconst secret = $env.EDULEDGER_WEBHOOK_SECRET || '{{EDULEDGER_WEBHOOK_SECRET}}';\nconst body = $input.first().body;\n\nconst rawPayload = JSON.stringify(body);\nconst expectedSig = 'sha256=' + crypto.createHmac('sha256', secret).update(rawPayload).digest('hex');\n\nconst isValidSignature = headerSig.length > 0 && crypto.timingSafeEqual(Buffer.from(headerSig), Buffer.from(expectedSig));\n\nreturn [\n  {\n    json: {\n      ...body,\n      isValidSignature,\n      receivedAt: new Date().toISOString()\n    }\n  }\n];"
      },
      "id": "node-verify-sig",
      "name": "Verify HMAC Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isValidSignature }}",
              "value2": true
            },
            {
              "value1": "={{ $json.parent.hasConsent }}",
              "value2": true
            },
            {
              "value1": "={{ $json.parent.optedOut }}",
              "value2": false
            }
          ],
          "string": [
            {
              "value1": "={{ $json.eventType }}",
              "value2": "attendance.marked"
            }
          ]
        }
      },
      "id": "node-filter-valid-attendance",
      "name": "Validate Event & Consent",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        620,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID || '{{WHATSAPP_PHONE_NUMBER_ID}}' }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHATSAPP_ACCESS_TOKEN || '{{WHATSAPP_ACCESS_TOKEN}}' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"recipient_type\": \"individual\",\n  \"to\": \"{{ $json.parent.phone.replace(/\\D/g, '') }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": {{ JSON.stringify($json.template.renderedMessage) }}\n  }\n}",
        "options": {
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 2000
        }
      },
      "id": "node-send-whatsapp",
      "name": "Send WhatsApp via Cloud API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        860,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EDULEDGER_WEBHOOK_URL || '{{EDULEDGER_WEBHOOK_URL}}' }}/api/whatsapp/webhook",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-EduLedger-Signature",
              "value": "={{ $node['Verify HMAC Signature'].json.headerSig || '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"providerMessageId\": \"{{ $json.messages ? $json.messages[0].id : $node['Validate Event & Consent'].json.messageId }}\",\n  \"status\": \"sent\",\n  \"timestamp\": \"{{ new Date().toISOString() }}\",\n  \"schoolId\": \"{{ $node['Validate Event & Consent'].json.schoolId }}\",\n  \"studentId\": \"{{ $node['Validate Event & Consent'].json.student.id }}\"\n}",
        "options": {
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 2000
        }
      },
      "id": "node-status-callback",
      "name": "EduLedger Status Callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1100,
        220
      ]
    }
  ],
  "connections": {
    "Webhook – Attendance Event": {
      "main": [
        [
          {
            "node": "Verify HMAC Signature",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify HMAC Signature": {
      "main": [
        [
          {
            "node": "Validate Event & Consent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Event & Consent": {
      "main": [
        [
          {
            "node": "Send WhatsApp via Cloud API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp via Cloud API": {
      "main": [
        [
          {
            "node": "EduLedger Status Callback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}