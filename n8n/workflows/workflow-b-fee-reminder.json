{
  "name": "Workflow B – EduLedger Fee Reminder (Daily Schedule)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "node-schedule-fees",
      "name": "Daily Schedule (9 AM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        160,
        240
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "fee-reminder-webhook",
        "options": {}
      },
      "id": "node-webhook-fees",
      "name": "Webhook – Fee Reminder",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        160,
        420
      ],
      "webhookId": "eduledger-fee-reminder-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Normalizes input whether triggered by schedule or direct webhook\nconst item = $input.first().json;\n\nif (item.eventType === 'fee.reminder') {\n  return [{ json: item }];\n}\n\n// If scheduled, it triggers reminder batch\nreturn [\n  {\n    json: {\n      action: 'process_due_reminders',\n      scheduledAt: new Date().toISOString()\n    }\n  }\n];"
      },
      "id": "node-prepare-fee-input",
      "name": "Normalize Fee Reminder Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.parent ? $json.parent.hasConsent : true }}",
              "value2": true
            },
            {
              "value1": "={{ $json.parent ? $json.parent.optedOut : false }}",
              "value2": false
            }
          ]
        }
      },
      "id": "node-check-fee-consent",
      "name": "Check Consent & Opt-Out",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        620,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID || '{{WHATSAPP_PHONE_NUMBER_ID}}' }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHATSAPP_ACCESS_TOKEN || '{{WHATSAPP_ACCESS_TOKEN}}' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"recipient_type\": \"individual\",\n  \"to\": \"{{ $json.parent.phone.replace(/\\D/g, '') }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": {{ JSON.stringify($json.template.renderedMessage) }}\n  }\n}",
        "options": {
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 2000
        }
      },
      "id": "node-send-fee-whatsapp",
      "name": "Send WhatsApp Fee Reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        860,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EDULEDGER_WEBHOOK_URL || '{{EDULEDGER_WEBHOOK_URL}}' }}/api/whatsapp/webhook",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"providerMessageId\": \"{{ $json.messages ? $json.messages[0].id : '' }}\",\n  \"status\": \"sent\",\n  \"timestamp\": \"{{ new Date().toISOString() }}\",\n  \"eventType\": \"fee.reminder\"\n}",
        "options": {
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 2000
        }
      },
      "id": "node-fee-callback",
      "name": "Update Fee History Callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1100,
        240
      ]
    }
  ],
  "connections": {
    "Daily Schedule (9 AM)": {
      "main": [
        [
          {
            "node": "Normalize Fee Reminder Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook – Fee Reminder": {
      "main": [
        [
          {
            "node": "Normalize Fee Reminder Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Fee Reminder Input": {
      "main": [
        [
          {
            "node": "Check Consent & Opt-Out",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Consent & Opt-Out": {
      "main": [
        [
          {
            "node": "Send WhatsApp Fee Reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp Fee Reminder": {
      "main": [
        [
          {
            "node": "Update Fee History Callback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}