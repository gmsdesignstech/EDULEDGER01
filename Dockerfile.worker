# Dockerfile.worker
# Lightweight container image for running the EduLedger WhatsApp Background Worker
FROM node:22-alpine

WORKDIR /app

# Install dependencies required by the worker
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev --ignore-scripts

# Copy worker script and application code
COPY scripts/ scripts/
COPY src/lib/ src/lib/

# Set production environment
ENV NODE_ENV=production

# Healthcheck to verify the worker script syntax
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD node scripts/whatsapp-worker.mjs --check || exit 1

# Run the persistent worker loop
CMD ["node", "scripts/whatsapp-worker.mjs"]

