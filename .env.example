# On Vercel, use the Supabase Transaction pooler URL (port 6543).
DATABASE_URL="postgresql://postgres.project-ref:password@pooler-host:6543/postgres?sslmode=require"
# If the Vercel integration prefix is EDULEDGER, its generated URL is also supported:
# EDULEDGER_POSTGRES_URL="postgresql://postgres.project-ref:password@pooler-host:6543/postgres?sslmode=require"
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Configure exactly one private platform administrator. User ID takes precedence.
ADMIN_USER_ID=""
ADMIN_EMAIL=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
CRON_SECRET="replace-with-a-long-random-secret"
CLOUDINARY_URL=""
AI_API_KEY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
