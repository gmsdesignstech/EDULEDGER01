# Server-only pooled PostgreSQL URL for application traffic. The URL must start
# with postgres:// or postgresql://. Never expose it through NEXT_PUBLIC_*.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Development uses a dedicated PostgreSQL database whose name contains -dev.
# The production identity is credential-free and is used only for comparison.
EDULEDGER_ENVIRONMENT="development"
EDULEDGER_DEV_DATABASE_URL="postgresql://DEV_USER:PASSWORD@DEV_HOST:5432/eduledger-dev?sslmode=require"
EDULEDGER_PRODUCTION_DATABASE_IDENTITY="postgresql://PROD_HOST:5432/PROD_DATABASE"
EDULEDGER_ALLOW_SCHEMA_INITIALIZATION="0"

# Vitest integration tests require a separately provisioned, isolated disposable database.
# Configure these in the test shell/secret store, not in the ordinary development environment.
TEST_DATABASE_URL="postgresql://TEST_USER:PASSWORD@TEST_HOST:5432/eduledger-test?sslmode=require"
TEST_DATABASE_PRODUCTION_IDENTITY="postgresql://PROD_HOST:5432/PROD_DATABASE"
TEST_DATABASE_TARGET_CONFIRMED_DISPOSABLE="0"
TEST_DATABASE_ALLOW_SCHEMA_INIT="0"
EDULEDGER_TEST_TARGET_ISOLATED="0"

# Meta WhatsApp Cloud API (server-only; never expose these to browser code).
# Keep dispatch disabled until PostgreSQL, Meta credentials, templates, webhook,
# consent, and an authorized test recipient have all been verified.
WHATSAPP_GRAPH_VERSION=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_DOCUMENT_SIGNING_SECRET=""
# JSON object keyed by the server-authoritative institution ID. Each entry may
# contain only that institution's Meta sender identifiers and secret token.
# Supply this through the deployment secret manager, never through the browser.
WHATSAPP_INSTITUTION_PROVIDER_CONFIG_JSON=""
WHATSAPP_DISPATCH_ENABLED="0"
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Configure exactly one private platform administrator. User ID takes precedence.
ADMIN_USER_ID="replace-with-private-admin-user-id"
ADMIN_EMAIL="admin@example.com"

# Razorpay can remain in test mode until live payments are explicitly enabled.
RAZORPAY_KEY_ID="rzp_test_replace_me"
RAZORPAY_KEY_SECRET="replace-with-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-razorpay-webhook-secret"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
CLOUDINARY_URL=""
AI_API_KEY=""


# Vercel sends this value as a Bearer token when invoking the subscription cron.
CRON_SECRET="replace-with-a-long-random-secret"

# Canonical public HTTPS origin used by metadata, robots.txt, sitemap.xml, and
# externally shared document links. Do not include a trailing slash.
NEXT_PUBLIC_APP_URL="https://eduledger.co.in"
